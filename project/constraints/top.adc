# set_pin_assignment	{ vga_g[0] }	{ LOCATION = G11; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_g[1] }	{ LOCATION = J11; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_g[2] }	{ LOCATION = K16; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_g[3] }	{ LOCATION = K15; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_g[4] }	{ LOCATION = J16; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_g[5] }	{ LOCATION = J14; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_b[0] }	{ LOCATION = J13; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_b[1] }	{ LOCATION = K14; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_b[2] }	{ LOCATION = J12; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_b[3] }	{ LOCATION = K12; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_b[4] }	{ LOCATION = L14; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_hs }	{ LOCATION = M14; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }
# set_pin_assignment	{ vga_vs }	{ LOCATION = P14; IOSTANDARD = LVCMOS33; SLEWRATE = FAST; }

# ---- SD 卡（SPI 模式）----
set_pin_assignment	{ sd_clk }	{ LOCATION = F15; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ sd_cs }	{ LOCATION = F13; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ sd_mosi }	{ LOCATION = F14; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ sd_miso }	{ LOCATION = D14; IOSTANDARD = LVCMOS33; }

# ---- 音频输出（PWM → 功放）----
set_pin_assignment	{ audio_pwm }	{ LOCATION = F3; IOSTANDARD = LVCMOS33; }

# ---- 麦克风 SPI ADC ----
set_pin_assignment	{ mic_cs }	{ LOCATION = J6; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ mic_miso }	{ LOCATION = K5; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ mic_sck }	{ LOCATION = H3; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ mic_rst_n }	{ LOCATION = G6; IOSTANDARD = LVCMOS33; }

# ---- 4 位七段数码管 ----
set_pin_assignment	{ seg_sel[0] }	{ LOCATION = C9; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_sel[1] }	{ LOCATION = B6; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_sel[2] }	{ LOCATION = A5; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_sel[3] }	{ LOCATION = A3; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[0] }	{ LOCATION = A4; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[1] }	{ LOCATION = A6; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[2] }	{ LOCATION = B8; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[3] }	{ LOCATION = E8; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[4] }	{ LOCATION = A7; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[5] }	{ LOCATION = B5; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[6] }	{ LOCATION = A8; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ seg_led[7] }	{ LOCATION = C8; IOSTANDARD = LVCMOS33; }

# ---- 4x4 矩阵键盘 ----
set_pin_assignment	{ kb_row[0] }	{ LOCATION = D9;  IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_row[1] }	{ LOCATION = F9;  IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_row[2] }	{ LOCATION = C10; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_row[3] }	{ LOCATION = E10; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_col[0] }	{ LOCATION = E11; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_col[1] }	{ LOCATION = D11; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_col[2] }	{ LOCATION = C11; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ kb_col[3] }	{ LOCATION = F10; IOSTANDARD = LVCMOS33; }

# ---- 8 位 LED（与 R-2R DAC 复用）----
set_pin_assignment	{ led[0] }	{ LOCATION = B14; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[1] }	{ LOCATION = B15; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[2] }	{ LOCATION = B16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[3] }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[4] }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[5] }	{ LOCATION = E13; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[6] }	{ LOCATION = E16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[7] }	{ LOCATION = F16; IOSTANDARD = LVCMOS33; }

