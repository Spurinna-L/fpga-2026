#=============================================================================
# top.adc  —  引脚约束（EG4S20BG256 · 大拇指核心板 + 综合底板）
#-----------------------------------------------------------------------------
# 权威来源：官方例程 .adc（10_VGA_hdmi_tx_display_MB/hdmi.adc、
#   6_SD_Card_SPI/sd_card.adc、1_AudioADC/audioadc.adc、
#   3_LCD_320x240/FPGA_LCD.adc、5_PWM_DAC_DDS/PWM_DAC_DDS.adc）。
# 顶层模块：top
#=============================================================================

# ---- 时钟 / 复位 ----
set_pin_assignment	{ clk_50m }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ rst_n_in }	{ LOCATION = A9; IOSTANDARD = LVCMOS33; }

# ---- HDMI（软 TMDS，LVDS33）----
set_pin_assignment	{ hdmi_clk_p }	{ LOCATION = P1; IOSTANDARD = LVDS33; }
set_pin_assignment	{ hdmi_d0_p }	{ LOCATION = N1; IOSTANDARD = LVDS33; }
set_pin_assignment	{ hdmi_d1_p }	{ LOCATION = P4; IOSTANDARD = LVDS33; }
set_pin_assignment	{ hdmi_d2_p }	{ LOCATION = J3; IOSTANDARD = LVDS33; }

# ---- VGA（已砍掉，保留引脚备查；如需可恢复 vga_out.v 与本节）----
